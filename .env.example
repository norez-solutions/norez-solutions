# Resend (resend.com) -- powers the contact form's email delivery. Requires
# a Resend account with norezsolutions.com verified as a sending domain.
# Without these three set, the contact form will show an error rather than
# silently pretending to send.
RESEND_API_KEY=
# Must be an address on a domain verified with Resend, e.g. hello@norezsolutions.com
CONTACT_FROM_EMAIL=
# Where contact form submissions should land
CONTACT_NOTIFY_EMAIL=
